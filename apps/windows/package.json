{
  "name": "@offhand/windows",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "windows": "npx @react-native-community/cli run-windows",
    "start": "react-native start --config metro.config.js",
    "bundle": "react-native bundle --platform windows --dev false --entry-file index.js --bundle-output windows/OffhandReactnative/Bundle/index.windows.bundle --assets-dest windows/OffhandReactnative/Bundle",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "test:windows": "jest --config jest.config.windows.js",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.82.1",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-marked": "^8.0.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.4",
    "react-native-windows": "0.82.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@rnx-kit/jest-preset": "^0.1.17",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-config": "^0.83.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "OffhandReactnative",
      "namespace": "OffhandReactnative",
      "template": "cpp-app"
    }
  }
}
